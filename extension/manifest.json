{
  "manifest_version": 3,
  "name": "读懂",
  "version": "0.3.1",
  "description": "X / YouTube 一键读懂：英文富媒体 → 中文卡片解读，可追问、存灵感库（依赖本机 knowledge-workbench 后端）",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "读懂", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" } },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"]
}
