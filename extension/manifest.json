{
  "manifest_version": 3,
  "name": "KW 解读",
  "version": "0.1.2",
  "description": "X / YouTube 一键解读：英文富媒体 → 中文卡片解读，可追问、存灵感库（依赖本机 knowledge-workbench 后端）",
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"]
}
